# Copy to .env and fill in locally. .env is git-ignored and Claude is denied access to it.
# Every value here is a placeholder. Real values live only in the production secret store.

# Where the SQLite database and uploaded files live (outside the repo is fine).
DATABASE_PATH=./data/pharmacy-admin.db
FILES_DIR=./data/files

# 32 random bytes, base64. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts prescription numbers stored in the CQI module. Losing it makes those fields unreadable.
APP_ENCRYPTION_KEY=EXAMPLE_REPLACE_ME

# Session cookie signing secret, same generator.
SESSION_SECRET=EXAMPLE_REPLACE_ME
